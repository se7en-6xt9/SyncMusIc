rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required) - User's unique ID
    //   - fullName: string (required) - User's full name
    //   - username: string (required) - Unique username
    //   - gender: string (optional) - User's gender
    //   - photoURL: string (optional) - Profile picture URL
    //   - createdAt: number (optional) - Creation timestamp
    //
    // Collection: usernames
    // Document ID: {username}
    // Fields:
    //   - uid: string (required) - User's unique ID
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'username']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() < 100 &&
             data.username is string && data.username.size() >= 3 && data.username.size() < 30;
    }

    function isValidUsername(data) {
      return data.keys().hasAll(['uid']) &&
             data.uid is string && data.uid == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
    }

    // Username uniqueness check
    match /usernames/{username} {
      allow read: if true; // Publicly readable for uniqueness check
      allow create: if isAuthenticated() && isValidUsername(request.resource.data);
      allow update: if false; // Usernames are immutable for now
    }
  }
}
