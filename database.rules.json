{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      "$roomCode": {
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid || data.child('members').child(auth.uid).exists())",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "sync": {
          ".write": "auth != null && (data.parent().child('createdBy').val() === auth.uid || data.parent().child('members').child(auth.uid).exists())"
        }
      }
    }
  }
}
