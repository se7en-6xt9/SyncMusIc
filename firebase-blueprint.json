{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "username": { "type": "string" },
        "gender": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "fullName", "username"]
    },
    "Username": {
      "title": "Username",
      "description": "Mapping of username to UID for uniqueness check",
      "type": "object",
      "properties": {
        "uid": { "type": "string" }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/usernames/{username}": {
      "schema": "Username",
      "description": "Username uniqueness check"
    }
  }
}
